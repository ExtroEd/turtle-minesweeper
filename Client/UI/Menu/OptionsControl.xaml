<UserControl x:Class="Client.UI.Menu.OptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock Text="Options" 
                   Style="{StaticResource PageHeaderTextStyle}"/>
        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Window Mode" FontWeight="Bold" Margin="0,10,0,5"/>
            <ComboBox x:Name="WindowModeComboBox" SelectedIndex="0" Margin="0,0,0,20">
                <ComboBoxItem Content="Fullscreen (Recommended)" />
                <ComboBoxItem Content="Fullscreen Windowed" />
                <ComboBoxItem Content="Windowed" />
            </ComboBox>

            <TextBlock Text="Controls" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Move Up:" Width="120"/>
                <Button x:Name="MoveUpButton" Width="100" Click="Rebind_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Move Down:" Width="120"/>
                <Button x:Name="MoveDownButton" Width="100" Click="Rebind_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Move Left:" Width="120"/>
                <Button x:Name="MoveLeftButton" Width="100" Click="Rebind_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Move Right:" Width="120"/>
                <Button x:Name="MoveRightButton" Width="100" Click="Rebind_Click"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Toggle Profiler:" Width="120"/>
                <Button x:Name="ToggleProfilerButton" Width="100" Click="Rebind_Click"/>
            </StackPanel>
            
            <Button Content="Apply Settings" 
                    Style="{StaticResource MainButtonStyle}" 
                    Click="ApplySettings_Click" 
                    Margin="0,15,0,0"/>
            <Button Content="Reset Settings" 
                    Style="{StaticResource RedButtonStyle}" 
                    Click="ResetSettings_Click" 
                    Margin="0,15,0,0"/>
            <Button Content="Back" 
                    Style="{StaticResource RedButtonStyle}" 
                    Click="Back_Click" 
                    Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
