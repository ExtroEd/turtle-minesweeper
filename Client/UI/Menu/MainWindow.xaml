<menu:BaseWindow x:Class="Client.UI.Menu.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Client.UI"
                  xmlns:menu="clr-namespace:Client.UI.Menu"
                  xmlns:shared="clr-namespace:Client.UI.Shared"
                  Title="Turtle Minesweeper">
    
    <Grid>
        <TextBlock Style="{StaticResource TitleTextStyle}" 
                   x:Name="TitleText"/>
        <TextBlock Style="{StaticResource SplashTextStyle}" 
                   x:Name="SplashText"/>
        <TextBlock Style="{StaticResource VersionTextStyle}" 
                   x:Name="VersionText"/>

        <Grid x:Name="MainContainer"/>
        <shared:ProfilerControl/>
    </Grid>
</menu:BaseWindow>
