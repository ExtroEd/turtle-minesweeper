<UserControl x:Class="Client.UI.Menu.SinglePlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock Text="Birth mode" 
                   Style="{StaticResource PageHeaderTextStyle}"/>
        
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Width="320">
            <TextBlock Text="Grid Size (10–500)" 
                       Style="{StaticResource LabelTextStyle}"/>
            <TextBox x:Name="GridSizeTextBox" 
                     Style="{StaticResource InputTextBoxStyle}" 
                     TextChanged="GridSizeTextBox_OnTextChanged"/>
            <Slider x:Name="GridSizeSlider"
                    Minimum="10"
                    Maximum="500"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="GridSizeSlider_OnValueChanged"
                    Margin="0,2,0,0"/>

            <TextBlock Text="Total Obstacles % (1–80)" 
                       Style="{StaticResource LabelTextStyle}" 
                       Margin="0,10,0,0"/>
            <Slider x:Name="TotalObstacleSlider" 
                    Minimum="1" 
                    Maximum="80" 
                    TickFrequency="1" 
                    IsSnapToTickEnabled="True" 
                    ValueChanged="TotalObstacleSlider_OnValueChanged"
                    Margin="0,10,0,0"/>

            <TextBlock HorizontalAlignment="Center"
                       Text="{Binding ElementName=TotalObstacleSlider,
                              Path=Value,
                              StringFormat='{}{0:##0}%'}"
                       Margin="0,2,0,0"/>

            <StackPanel x:Name="SplitPanel" Margin="0,10,0,0">
                <TextBlock Text="Wall / Mine distribution" 
                           Style="{StaticResource LabelTextStyle}"/>
                <Grid Margin="0,5,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left">
                        <TextBlock Text="Walls %" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock x:Name="WallPercentTextBlock"
                                   Width="50"
                                   Text="{Binding WallPercent}" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="Mines %" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock x:Name="MinePercentTextBlock"
                                   Width="50"
                                   Text="{Binding MinePercent}" 
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <Slider x:Name="SplitSlider"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Minimum="0"
                            Maximum="80"
                            TickFrequency="1" 
                            IsSnapToTickEnabled="True" 
                            ValueChanged="SplitSlider_OnValueChanged"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0">
                        <Slider.LayoutTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Slider.LayoutTransform>
                    </Slider>
                </Grid>
            </StackPanel>

            <CheckBox x:Name="EnableFoxCheckBox"
                      Content="Enable enemy fox"
                      Margin="0,10,0,5"
                      Checked="EnableFoxCheckBox_Checked"
                      Unchecked="EnableFoxCheckBox_Unchecked"/>

            <StackPanel x:Name="FoxSpeedPanel" Margin="0,5,0,0">
                <TextBlock Text="Fox Speed (1–10 squares/sec)" 
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="FoxSpeedTextBox" 
                         Style="{StaticResource InputTextBoxStyle}" 
                         TextChanged="FoxSpeedTextBox_OnTextChanged"/>
                <Slider x:Name="FoxSpeedSlider"
                        Minimum="1"
                        Maximum="10"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="FoxSpeedSlider_OnValueChanged"
                        Margin="0,2,0,0"/>
            </StackPanel>

            <Button Content="Random parameters" 
                    Style="{StaticResource MainButtonStyle}" 
                    Click="RandomButton_Click" 
                    Margin="0 15 0 0"/>
            <Button Content="Start Game" 
                    Style="{StaticResource MainButtonStyle}" 
                    Click="StartGame_Click" 
                    Margin="0 15 0 0"/>
            <Button Content="Back" 
                    Style="{StaticResource RedButtonStyle}" 
                    Click="Back_Click" 
                    Margin="0 15 0 0"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,22,14"
                    Background="#00000000">
            <TextBlock Text="Developer mode"
                       FontSize="16"
                       Margin="0,0,8,10"
                       VerticalAlignment="Center"/>
            <CheckBox x:Name="DeveloperModeCheckBox"
                      Content="Developer mode"
                      Width="21"
                      Height="21"
                      VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
