<UserControl x:Class="Client.UI.SinglePlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

            <!-- GRID SIZE -->
            <TextBlock Text="Grid Size (10–500)" Style="{StaticResource LabelTextStyle}"/>
            <TextBox x:Name="GridSizeTextBox" Style="{StaticResource InputTextBoxStyle}"/>

            <!-- TOTAL OBSTACLES -->
            <TextBlock Text="Total Obstacles % (0–60)" Style="{StaticResource LabelTextStyle}" Margin="0,10,0,0"/>
            <Slider x:Name="TotalObstacleSlider" Minimum="0" Maximum="60" ValueChanged="TotalObstacleSlider_OnValueChanged"/>
            <TextBlock Text="0%" HorizontalAlignment="Center"/>

            <!-- WALL / MINE SPLIT SECTION -->
            <StackPanel x:Name="SplitPanel" Visibility="Collapsed" Margin="0,10,0,0">

                <TextBlock Text="Wall / Mine distribution" Style="{StaticResource LabelTextStyle}" />

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- WALL VALUE -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Walls %" Style="{StaticResource LabelTextStyle}" />
                        <TextBox x:Name="WallPercentTextBox"
                                 Width="50"
                                 TextChanged="WallPercentTextBox_OnTextChanged"
                                 Style="{StaticResource InputTextBoxStyle}"/>
                    </StackPanel>

                    <!-- SLIDER -->
                    <Slider x:Name="SplitSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            ValueChanged="SplitSlider_OnValueChanged"
                            Orientation="Vertical"
                            Height="80"
                            VerticalAlignment="Center"/>

                    <!-- MINE VALUE -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Mines %" Style="{StaticResource LabelTextStyle}" />
                        <TextBox x:Name="MinePercentTextBox"
                                 Width="50"
                                 TextChanged="MinePercentTextBox_OnTextChanged"
                                 Style="{StaticResource InputTextBoxStyle}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ENABLE FOX -->
            <CheckBox x:Name="EnableFoxCheckBox"
                      Content="Enable enemy fox"
                      Margin="0,10,0,5"
                      Checked="EnableFoxCheckBox_Checked"
                      Unchecked="EnableFoxCheckBox_Unchecked"/>

            <!-- FOX SPEED -->
            <StackPanel x:Name="FoxSpeedPanel" Visibility="Collapsed">
                <TextBlock Text="Fox Speed (1–10 squares/sec)" Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="FoxSpeedTextBox" Style="{StaticResource InputTextBoxStyle}"/>
            </StackPanel>

            <!-- BUTTONS -->
            <Button Content="Start Game" Style="{StaticResource MainButtonStyle}" Click="StartGame_Click" Margin="0 15 0 0"/>
            <Button Content="Back" Style="{StaticResource RedButtonStyle}" Click="Back_Click" Margin="0 15 0 0"/>
        </StackPanel>
    </Grid>
</UserControl>
