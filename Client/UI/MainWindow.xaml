<local:BaseWindow x:Class="Client.UI.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Client.UI"
                  Title="Turtle Minesweeper">
    
    <Grid>
        <TextBlock Style="{StaticResource TitleTextStyle}" 
                   x:Name="TitleText"/>
        <TextBlock Style="{StaticResource SplashTextStyle}" 
                   x:Name="SplashText"/>
        <TextBlock Style="{StaticResource VersionTextStyle}" 
                   x:Name="VersionText"/>

        <Grid x:Name="MainContainer"/>
        <local:ProfilerControl/>
    </Grid>
</local:BaseWindow>
