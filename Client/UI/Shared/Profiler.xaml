<UserControl x:Class="Client.UI.Shared.ProfilerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Background="Transparent"
             IsHitTestVisible="False"
             Visibility="Collapsed">

    <Grid Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Border Background="#CC333333"
                CornerRadius="4"
                Padding="8"
                Opacity="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False">
            <StackPanel>

                <TextBlock x:Name="StatsText"
                           Foreground="#ffffff"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextWrapping="NoWrap"
                           IsHitTestVisible="False"/>

                <TextBlock
                    Foreground="#ffffff"
                           FontFamily="Consolas"
                           FontSize="14"
                           Margin="0,6,0,0"
                           Text="F3 — toggle profiler"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
